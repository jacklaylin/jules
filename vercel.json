{
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/price-checks",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/onboarding",
      "destination": "/onboarding.html"
    },
    {
      "source": "/signup",
      "destination": "/signup.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/simulator",
      "destination": "/simulator.html"
    },
    {
      "source": "/style",
      "destination": "/style.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/wishlist",
      "destination": "/wishlist.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' blob: https://www.barbour.com https://deeceestyle.ch; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "functions": {
    "api/image.js": {
      "includeFiles": "public/brand/previews/fallback-v1.png",
      "maxDuration": 30
    },
    "api/**/*.js": {
      "includeFiles": "{VOICE.md,node_modules/pdfjs-dist/standard_fonts/**,node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs}",
      "maxDuration": 120
    }
  },
  "regions": [
    "yul1"
  ]
}
