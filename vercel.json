{
  "outputDirectory": "public",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/price-checks",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/wishlist?gmail=refresh",
      "schedule": "0 17 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/simulator",
      "destination": "/admin/test-chat",
      "permanent": false
    },
    {
      "source": "/simulator.html",
      "destination": "/admin/test-chat",
      "permanent": false
    },
    {
      "source": "/replay.html",
      "destination": "/admin/replays",
      "permanent": false
    },
    {
      "source": "/search-diagnostic.html",
      "destination": "/admin/search",
      "permanent": false
    },
    {
      "source": "/identification-test.html",
      "destination": "/admin/identify",
      "permanent": false
    },
    {
      "source": "/costs.html",
      "destination": "/admin/costs",
      "permanent": false
    },
    {
      "source": "/report-jokes.html",
      "destination": "/admin/style-report",
      "permanent": false
    },
    {
      "source": "/adoption.html",
      "destination": "/admin/adoption",
      "permanent": false
    },
    {
      "source": "/admin.html",
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/admin/jokes",
      "destination": "/admin/style-report?view=jokes",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/report",
      "destination": "/report.html"
    },
    {
      "source": "/r/:token",
      "destination": "/api/wishlist?share_page=:token"
    },
    {
      "source": "/go/:token",
      "destination": "/api/image?go=:token"
    },
    {
      "source": "/onboarding/connect",
      "destination": "/onboarding.html"
    },
    {
      "source": "/onboarding/thinking",
      "destination": "/onboarding.html"
    },
    {
      "source": "/onboarding/reading",
      "destination": "/onboarding.html"
    },
    {
      "source": "/onboarding-preview",
      "destination": "/onboarding-preview.html"
    },
    {
      "source": "/onboarding",
      "destination": "/onboarding.html"
    },
    {
      "source": "/signup",
      "destination": "/signup.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/style",
      "destination": "/style.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/people/:id",
      "destination": "/admin-person.html"
    },
    {
      "source": "/admin/test-chat",
      "destination": "/simulator.html"
    },
    {
      "source": "/admin/replays",
      "destination": "/replay.html"
    },
    {
      "source": "/admin/search",
      "destination": "/search-diagnostic.html"
    },
    {
      "source": "/admin/identify",
      "destination": "/identification-test.html"
    },
    {
      "source": "/admin/costs",
      "destination": "/costs.html"
    },
    {
      "source": "/admin/adoption",
      "destination": "/adoption.html"
    },
    {
      "source": "/admin/quality",
      "destination": "/scorecard.html"
    },
    {
      "source": "/admin/style-report",
      "destination": "/report-jokes.html"
    },
    {
      "source": "/wishlist",
      "destination": "/wishlist.html"
    },
    {
      "source": "/wardrobe",
      "destination": "/wardrobe.html"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' blob: https://www.barbour.com https://deeceestyle.ch; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/(api|r|go)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/image.js": {
      "includeFiles": "public/brand/previews/saved-v2.png",
      "maxDuration": 30
    },
    "api/wishlist.js": {
      "includeFiles": "{VOICE.md,public/report.html,node_modules/.pnpm/pdfjs-dist@*/node_modules/pdfjs-dist/standard_fonts/**,node_modules/.pnpm/pdfjs-dist@*/node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs}",
      "maxDuration": 300
    },
    "api/**/*.js": {
      "includeFiles": "VOICE.md",
      "maxDuration": 120
    }
  },
  "regions": [
    "yul1"
  ]
}
