SPECTRUM_PROJECT_ID=replace-with-your-photon-project-id
SPECTRUM_PROJECT_SECRET=replace-with-your-private-photon-project-secret
SPECTRUM_WEBHOOK_SECRET=replace-with-your-private-webhook-signing-secret
SUPABASE_URL=https://replace-with-your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-public-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-private-supabase-service-role-key
ADMIN_EMAIL=replace-with-your-owner-email
SITE_ORIGIN=https://replace-with-your-vercel-domain

# Enable only after running db/002_ai.sql and setting a funded API key.
AI_ENABLED=false
OPENAI_API_KEY=replace-with-your-private-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
# Optional: the model that talks to the user (chat agent loop and reply composer). Defaults to OPENAI_MODEL.
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Optional: the model that writes the style report's joke lines. Defaults to gpt-5.5.
STYLE_REPORT_MODEL=gpt-5.5
# Optional: the model that turns an open-ended request into a few concrete search directions
# (lib/stylist.js). Defaults to gpt-5.5. Set STYLIST_ENABLED=false to go back to one search.
STYLIST_MODEL=gpt-5.5
# Optional: the model that reads durable taste facts from each message (lib/memory.js). Defaults to gpt-4.1.
MEMORY_MODEL=gpt-4.1
STYLIST_ENABLED=true
# Optional: time budget for one chat turn in milliseconds (default 100000, inside the 120-second limit).
AGENT_DEADLINE_MS=100000

# Apply db/009_price_alerts.sql before enabling. Daily scheduler checks alerts due every 3 days.
PRICE_ALERTS_ENABLED=false
CRON_SECRET=replace-with-a-long-random-private-secret
# Weekly search for other stores selling a watched item (uses SerpAPI credits). Set false to turn off.
PRICE_ALERT_DISCOVERY=true
# Conversation ID of a dedicated test identity; the only one allowed to receive simulated alert texts.
PRICE_ALERT_TEST_CONVERSATION_ID=

# Founder alerts: a text to this phone whenever a tester gets the generic fallback reply or a reply
# stalls (watchdog: apply db/028_reply_reliability.sql). Sent from the tester's Photon line. Store the
# real number only in Vercel's environment settings, in international format. Leave empty to turn off.
FOUNDER_ALERT_PHONE=replace-with-your-phone-in-international-format

# Enable after running db/003_memory.sql.
MEMORY_ENABLED=false

# Milestone 5: receive private inspiration screenshots (requires db/004_images.sql).
IMAGES_ENABLED=false

# Milestone 6 links-only sourcing (requires db/005_search.sql).
SEARCH_ENABLED=false

# Optional visual search: enable only after SerpApi account/key and image-sharing approval.
VISUAL_SEARCH_ENABLED=false
SERPAPI_API_KEY=replace-with-your-private-serpapi-key

# Owner-only billing reads for the admin Costs page. Store real values only in Vercel. See README "Billing connections".
# OpenAI organization Admin key (separate from OPENAI_API_KEY).
OPENAI_BILLING_ADMIN_KEY=replace-with-your-private-openai-admin-key
# Optional: Jules project ID. Set it to count only Jules' OpenAI spend; empty counts the whole organization.
OPENAI_BILLING_PROJECT_ID=replace-with-your-jules-openai-project-id

# Owner-only GitHub billing: fine-grained token with Account > Plan: read only.
GITHUB_BILLING_TOKEN=replace-with-your-private-github-billing-token
GITHUB_BILLING_USER=replace-with-your-github-username
GITHUB_BILLING_REPOSITORY=replace-with-owner/repository
# Vercel token scoped to the Jules team. Never use a broad personal token if avoidable.
VERCEL_BILLING_TOKEN=replace-with-your-private-vercel-token
VERCEL_BILLING_TEAM_SLUG=replace-with-your-vercel-team-slug
# Optional: Jules project ID. Set it to leave other Vercel projects out; plan and seat fees still count.
VERCEL_BILLING_PROJECT_ID=replace-with-your-vercel-project-id

# Optional: dollars per SerpApi search when the plan isn't the Starter plan ($25 / 1,000 searches = 0.025).
SERPAPI_COST_PER_SEARCH=

# Spending caps (COST-CAPS.md). Dollars of metered OpenAI + SerpApi spend, per UTC day or month.
# Empty or 0 = no cap. Per person: Jules stops paid work for that person. Global: for everyone, and new signups pause.
COST_CAP_USER_DAILY_USD=
COST_CAP_USER_MONTHLY_USD=
COST_CAP_GLOBAL_DAILY_USD=
COST_CAP_GLOBAL_MONTHLY_USD=

# Companion wishlist: requires db/008_wishlist.sql and invited email mappings.
WISHLIST_ENABLED=false

# Style starter pack: apply db/010_style.sql; uses existing invited sign-in and OpenAI key.
STYLE_ENABLED=false

# Public early-access form: apply db/014_public_signup.sql before enabling.
# Collects consent; invited outbound messages additionally require ONBOARDING_ENABLED.
PUBLIC_SIGNUP_ENABLED=false
# Optional Photon line for the user-initiated Open Messages button. Store in deployment settings.
JULES_PUBLIC_LINE=replace-with-your-photon-line-in-international-format

# Invite-only Gmail onboarding DEMO: apply db/016_onboarding.sql and follow ONBOARDING.md.
# Sends real onboarding texts to explicitly provisioned testers after web consent.
ONBOARDING_ENABLED=false

# Waitlist: apply db/035_waitlist.sql first. When true, numbers that are not approved get
# 3 Jules replies, then a waitlist notice at most once a day. Existing conversations are approved.
WAITLIST_ENABLED=false

# Real invite-only Gmail purchase-history pilot: apply db/017_gmail_import.sql.
# Keep disabled until GMAIL-IMPORT.md setup and account-isolation checks pass.
GMAIL_IMPORT_ENABLED=false
# Daily check for new purchases in connected Gmail, with one text a day about them (uses CRON_SECRET).
PURCHASE_TEXTS_ENABLED=false
# Fit checks a few days after delivery run with the purchase texts; set to false to stop only them.
FIT_CHECKS_ENABLED=true
GOOGLE_GMAIL_CLIENT_ID=replace-with-your-google-web-oauth-client-id
GOOGLE_GMAIL_CLIENT_SECRET=replace-with-your-private-google-oauth-client-secret
# Generate 32 random bytes encoded as base64; keep in deployment secret settings.
GMAIL_TOKEN_KEY=replace-with-your-private-32-byte-base64-encryption-key

# Shop (Shopify's agent catalog). Search and checkout links need no account or key. See SHOP.md.
# Adds Shop's catalog as one more search source; every result still passes the normal page check.
SHOP_CATALOG_ENABLED=false
# When the user says they're ready to buy: a cart link with their size for stores in Shop's catalog,
# otherwise the product page. Jules never pays or places an order.
CHECKOUT_LINKS_ENABLED=false
# Shop order history beside Gmail. Apply db/022_history_sources.sql first; needs the Gmail pilot settings.
SHOP_ORDERS_ENABLED=false

# Admin › Adoption link clicks. When true, product links in Jules replies are sent as short Jules links
# (SITE_ORIGIN/go/...) that record the tap and forward to the store. Testers then see a Jules link instead of
# the store's address. Apply db/032_adoption_events.sql first.
LINK_CLICK_TRACKING=false
